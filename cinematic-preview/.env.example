# Server environment only. Keep .env.local out of Git.
BACKEND_ENABLED=false
# Keep disabled until the email sender and authenticated workflows are verified.
AUTH_ENABLED=false
# Production-only app: missing backend configuration keeps online services unavailable.
SITE_MODE=launch
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_OR_SECRET_KEY
APP_ORIGIN=https://www.proverbs31cleaningcoservices.info
# Optional: enable only after Supabase anonymous auth + CAPTCHA and DB guest checkout are configured.
GUEST_CHECKOUT_ENABLED=false
TURNSTILE_SITE_KEY=
